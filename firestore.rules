rules_version = '2';

// InspireTrade Firestore security rules — trading domain.
//
// The trading domain (accounts, positions, orders, trades) is SERVER-ONLY:
// every read/write goes through /api/trading which verifies a Firebase ID
// token and uses the Admin SDK. The Admin SDK bypasses these rules, clients
// cannot bypass them — so a user can never forge a balance, position or fill
// from the browser console.
//
// Deploy: firebase deploy --only firestore:rules
service cloud.firestore {
  match /databases/{database}/documents {
    // Trading domain — server-only. Client read AND write are denied.
    match /users/{uid}/accounts/{document=**} {
      allow read, write: if false;
    }

    // Prop-firm domain — also server-only: challenge templates, the admin
    // audit log and the leaderboard settings switch. All writes happen with
    // the Admin SDK behind requireAdmin; clients get sanitized reads via
    // /api/trading (challenge-types, leaderboard) — never direct access.
    match /challengeTypes/{document=**} {
      allow read, write: if false;
    }
    match /propAudit/{document=**} {
      allow read, write: if false;
    }
    match /settings/{document=**} {
      allow read, write: if false;
    }

    // Default deny for everything else in Firestore. The site's non-trading
    // data lives in Realtime Database; if a future feature moves to Firestore
    // it must add an explicit match block here.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
